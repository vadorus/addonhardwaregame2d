; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Tech Empire Prototype V0.2.9 — Guided Company HQ"
run/main_scene="uid://e28phl1nvy5i"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameData="*res://scripts/GameData.gd"
Economy="*res://scripts/EconomyManager.gd"
CompanyManager="*res://scripts/CompanyManager.gd"
DivisionManager="*res://scripts/DivisionManager.gd"
PersonnelManager="*res://scripts/PersonnelManager.gd"
ResearchManager="*res://scripts/ResearchManager.gd"
PatentManager="*res://scripts/PatentManager.gd"
MarketManager="*res://scripts/MarketManager.gd"
MediaManager="*res://scripts/MediaManager.gd"
ProductManager="*res://scripts/ProductManager.gd"
SimulationManager="*res://scripts/SimulationManager.gd"
TimeManager="*res://scripts/TimeManager.gd"
SaveManager="*res://scripts/SaveManager.gd"
BugReporter="*res://scripts/BugReporter.gd"
UpdateManager="*res://scripts/UpdateManager.gd"

[bug_reporting]

; Left empty until the isolated VPS collector is deployed.
; Reports remain only in user://bug_reports_queue.json while this is empty.
endpoint=""

[updates]

; HTTPS manifest hosted on the isolated Tech Empire VPS service.
; Kept empty until that service is deployed.
manifest_url=""
channel="preview"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/vram_compression/import_etc2_astc=true
