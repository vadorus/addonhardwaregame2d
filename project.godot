; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Tech Empire V0.11.0 RC2"
run/main_scene="uid://e28phl1nvy5i"
config/use_custom_user_dir=true
config/custom_user_dir_name="TechEmpire"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/branding/tech_empire_icon.svg"
config/quit_on_go_back=false

[autoload]

GameData="*res://scripts/GameData.gd"
BalanceManager="*res://scripts/BalanceManager.gd"
Economy="*res://scripts/EconomyManager.gd"
CompanyManager="*res://scripts/CompanyManager.gd"
DivisionManager="*res://scripts/DivisionManager.gd"
