; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Tech Empire V0.3.1 — UI Preview"
run/main_scene="res://ui/MainMenuV031.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameData="*res://scripts/GameData.gd"
BalanceManager="*res://scripts/BalanceManager.gd"
Economy="*res://scripts/EconomyManager.gd"
CompanyManager="*res://scripts/CompanyManager.gd"
DivisionManager="*res://scripts/DivisionManager.gd"
PersonnelManager="*res://scripts/PersonnelManager.gd"
ExecutiveManager="*res://scripts/ExecutiveManager.gd"
ResearchManager="*res://scripts/ResearchManager.gd"
FoundryManager="*res://scripts/FoundryManager.gd"
ProductionManager="*res://scripts/ProductionManager.gd"
PatentManager="*res://scripts/PatentManager.gd"
MarketManager="*res://scripts/MarketManager.gd"
MediaManager="*res://scripts/MediaManager.gd"
ProductManager="*res://scripts/ProductManager.gd"
AfterSalesManager="*res://scripts/AfterSalesManager.gd"
SimulationManager="*res://scripts/SimulationManager.gd"
TimeManager="*res://scripts/TimeManager.gd"
SaveManager="*res://scripts/SaveManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
